# MixID environment configuration.
# Copy to `.env` and fill in. All keys are free-tier.

# ── Paths inherited from the DJAgent toolkit (sibling project) ──────────────
# Leave blank to use defaults shown.
YTMUSIC_DIR=                       # default: C:\ytmusic
MUSIC_DIR=                         # default: ${YTMUSIC_DIR}\Music
FFMPEG_DIR=                        # default: ${YTMUSIC_DIR}
VDJ_DIR=                           # default: %USERPROFILE%\Documents\VirtualDJ
DJAGENT_LIBRARY_DB=                # default: %USERPROFILE%\OneDrive\Documents\DJAgent\data\library.db

# ── MixID data paths ────────────────────────────────────────────────────────
MIXID_DATA_DIR=                    # default: <repo>/data
MIXID_OUTPUTS_DIR=                 # default: <repo>/outputs

# ── Tier-1 free APIs ────────────────────────────────────────────────────────
# AcoustID raises rate limit to 3 req/sec when you set a key.
# Register: https://acoustid.org/api-key
ACOUSTID_API_KEY=

# ── Tier-2 free APIs ────────────────────────────────────────────────────────
# Genius API for lyrics search. Register: https://genius.com/api-clients
GENIUS_API_KEY=

# ACRCloud free trial (~14k queries, 14 days). Register: https://www.acrcloud.com
# Burn the trial across your real backlog; revert to free tier afterward.
ACRCLOUD_KEY=
ACRCLOUD_SECRET=
ACRCLOUD_HOST=                     # e.g. identify-eu-west-1.acrcloud.com

# Spotify "Add to playlist" feature uses ONE shared host account — yours.
# Set CLIENT_ID/SECRET from https://developer.spotify.com/dashboard, then
# run `python -m mixid.web.spotify_setup` to generate the host refresh
# token (paste the printed token below).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_HOST_REFRESH_TOKEN=         # filled in by `python -m mixid.web.spotify_setup`
SPOTIFY_REDIRECT_URI=               # default: http://localhost:8000/spotify/callback

# ── LLM provider (re-ranker + candidate-generator) ──────────────────────────
# Recommended: claude_code (uses Claude Code CLI subscription — no API key, no
#   quota burn, works automatically if you have Claude Code installed).
# Other options:
#   gemini (free tier — fragile, see notes below)
#   groq (free tier — needs key)
#   ollama (local, free — needs Ollama running)
#   anthropic (paid Anthropic API)
AI_PROVIDER=claude_code
AI_MODEL=                          # blank = sensible default per provider
# Empirical note on Gemini: free-tier keys get classified into a paid
# 'prepayment credits depleted' path when payloads include system_instruction
# or generationConfig. MixID's ai_provider strips these, but per-key
# per-minute limits still apply. For heavy use, prefer claude_code.
GEMINI_API_KEY=                    # https://aistudio.google.com/app/apikey
GROQ_API_KEY=                      # https://console.groq.com
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=
