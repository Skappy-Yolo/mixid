# MixID environment configuration.
# Copy to `.env` and fill in. All keys are free-tier.

# ── Paths inherited from the DJAgent toolkit (sibling project) ──────────────
# Leave blank to use defaults shown.
YTMUSIC_DIR=                       # default: C:\ytmusic
MUSIC_DIR=                         # default: ${YTMUSIC_DIR}\Music
FFMPEG_DIR=                        # default: ${YTMUSIC_DIR}
VDJ_DIR=                           # default: %USERPROFILE%\Documents\VirtualDJ
DJAGENT_LIBRARY_DB=                # default: %USERPROFILE%\OneDrive\Documents\DJAgent\data\library.db

# ── MixID data paths ────────────────────────────────────────────────────────
MIXID_DATA_DIR=                    # default: <repo>/data
MIXID_OUTPUTS_DIR=                 # default: <repo>/outputs

# ── Tier-1 free APIs ────────────────────────────────────────────────────────
# AcoustID raises rate limit to 3 req/sec when you set a key.
# Register: https://acoustid.org/api-key
ACOUSTID_API_KEY=

# ── Tier-2 free APIs ────────────────────────────────────────────────────────
# Genius API for lyrics search. Register: https://genius.com/api-clients
GENIUS_API_KEY=

# ACRCloud free trial (~14k queries, 14 days). Register: https://www.acrcloud.com
# Burn the trial across your real backlog; revert to free tier afterward.
ACRCLOUD_KEY=
ACRCLOUD_SECRET=
ACRCLOUD_HOST=                     # e.g. identify-eu-west-1.acrcloud.com

# ── LLM provider (re-ranker + candidate-generator) ──────────────────────────
# Options: gemini (free), groq (free), ollama (local/free), anthropic (paid)
AI_PROVIDER=gemini
AI_MODEL=                          # blank = sensible default per provider
GEMINI_API_KEY=                    # free: https://aistudio.google.com/app/apikey
GROQ_API_KEY=                      # free: https://console.groq.com
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=
